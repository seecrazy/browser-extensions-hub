{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**"]
    },
    "build:chrome": {
      "dependsOn": ["^build"],
      "outputs": [".output/chrome-mv3/**"]
    },
    "build:firefox": {
      "dependsOn": ["^build"],
      "outputs": [".output/firefox-mv3/**"]
    },
    "prepare": {
      "dependsOn": ["^prepare"]
    },
    "typecheck": {
      "dependsOn": ["^prepare"]
    },
    "lint": {},
    "test": {}
  }
}
