{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":enableVulnerabilityAlertsWithLabel(security)"
  ],
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Group TypeScript tooling",
      "matchPackageNames": ["typescript", "@types/chrome", "@hub/tsconfig"],
      "groupName": "typescript-tooling"
    },
    {
      "description": "Group lint and formatting",
      "matchPackageNames": ["eslint", "prettier", "typescript-eslint"],
      "groupName": "lint-format"
    },
    {
      "description": "Group testing",
      "matchPackageNames": ["vitest"],
      "groupName": "testing"
    },
    {
      "description": "Group publish CLIs",
      "matchPackageNames": ["chrome-webstore-upload-cli", "web-ext"],
      "groupName": "publish-clis"
    }
  ]
}
